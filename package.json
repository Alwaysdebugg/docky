{
  "name": "docky",
  "version": "0.1.0",
  "description": "Centralized Markdown doc manager for AI-agent-assisted development, with per-project scope isolation.",
  "keywords": [
    "markdown",
    "mcp",
    "ai-agents",
    "knowledge-base",
    "documentation",
    "cli"
  ],
  "homepage": "https://github.com/Alwaysdebugg/docky#readme",
  "bugs": {
    "url": "https://github.com/Alwaysdebugg/docky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alwaysdebugg/docky.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "docky": "dist/cli.js",
    "docky-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
